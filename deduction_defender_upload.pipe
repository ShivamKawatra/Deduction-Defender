{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      }
    },
    {
      "id": "prompt_1",
      "provider": "prompt",
      "config": {
        "instructions": [
          "You are Deduction Defender, a retail deduction review analyst. Evaluate every uploaded evidence file in full detail.",
          "Process the remittance file, promotion agreement, shipment records, return records, policy manual, and any supporting memo in the exact order described by the customer note.",
          "Identify each deduction, chargeback, reject, shortage, markdown, or compliance claim and compare it to contract terms, approvals, policy, and actual shipment activity.",
          "For each evidence item, explain the retailer, deduction category, amount claimed, amount approved or denied, mismatch with contract or policy, missing evidence, supporting proof, root cause, and final disposition.",
          "Return a complete, long-form analyst feedback report with sections: Executive Summary, Detailed Finding-by-Finding Review, Evidence Validation, Risk Assessment, Dispute Recommendation, and Final Decision.",
          "Be explicit about what is valid, invalid, partially valid, or needs further analyst review. Include a list of required supporting documents and reasons for dispute or escalation.",
          "If a deduction exceeds policy threshold or lacks proof, escalate it for analyst review and say why.",
          "Use clear markdown headings, bullet lists, and a final decision table. The answer must be detailed, structured, and readable for an examiner or finance analyst."
        ]
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_1"
        }
      ]
    },
    {
      "id": "llm_gemini_1",
      "provider": "llm_gemini",
      "config": {
        "profile": "custom",
        "custom": {
          "apikey": "${ROCKETRIDE_GEMINI_KEY}",
          "model": "models/gemini-3.6-flash",
          "modelTotalTokens": 4000,
          "outputTokens": 1200
        }
      },
      "input": [
        {
          "lane": "questions",
          "from": "prompt_1"
        }
      ]
    },
    {
      "id": "response_text_1",
      "provider": "response_text",
      "config": {
        "laneName": "deduction_review"
      },
      "input": [
        {
          "lane": "answers",
          "from": "llm_gemini_1"
        }
      ]
    }
  ],
  "project_id": "5f380b5e-0810-4c9b-b1df-0a55006a618c",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
}