{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      }
    },
    {
      "id": "prompt_1",
      "provider": "prompt",
      "config": {
        "instructions": [
          "Process the uploaded remittance file, promotion agreement, shipment records, and retailer compliance manual.",
          "Identify retailer chargebacks and unauthorized deductions and compare them to what was actually authorized.",
          "Explain missing evidence, contract mismatches, and which deduction should be disputed, written off, or escalated.",
          "Create a structured evidence summary with retailer name, deduction type, amount, root cause, supporting proof, and decision status.",
          "Any deduction above the policy threshold must be escalated for analyst review."
        ]
      },
      "input": [
        {
          "lane": "text",
          "from": "webhook_1"
        }
      ]
    },
    {
      "id": "llm_gemini_1",
      "provider": "llm_gemini",
      "config": {
        "profile": "custom",
        "custom": {
          "apikey": "${ROCKETRIDE_GEMINI_KEY}",
          "model": "models/gemini-3.6-flash",
          "modelTotalTokens": 4000,
          "outputTokens": 200
        }
      },
      "input": [
        {
          "lane": "questions",
          "from": "prompt_1"
        }
      ]
    },
    {
      "id": "response_text_1",
      "provider": "response_text",
      "config": {
        "laneName": "deduction_review"
      },
      "input": [
        {
          "lane": "answers",
          "from": "llm_gemini_1"
        }
      ]
    }
  ],
  "project_id": "8048eaa0-f714-4ae2-8823-32a9c9fd5d61",
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "version": 1
}