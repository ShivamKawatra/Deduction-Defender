{
  "components": [
    {
      "id": "chat_1",
      "provider": "chat",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "chat"
      }
    },
    {
      "id": "prompt_1",
      "provider": "prompt",
      "config": {
        "instructions": [
          "You are Deduction Defender, an analyst assistant for retail deduction review.",
          "Review each deduction against the signed retailer agreement, promotion terms, remittance data, and shipment records.",
          "Determine whether the deduction is valid, invalid, partially valid, or needs analyst review.",
          "For invalid deductions, explain the contract mismatch, summarize the evidence, and draft a detailed dispute package with supporting proof references.",
          "For valid deductions, explain the policy basis and recommend a write-off or approved adjustment only when the evidence supports it.",
          "Any deduction above the policy threshold must be escalated for analyst approval before final resolution.",
          "Return a detailed long-form recommendation with retailer, deduction type, amount, root cause, proof, exception rationale, risk level, and final disposition. Use clear headings and bullet points."
        ]
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ]
    },
    {
      "id": "llm_gemini_1",
      "provider": "llm_gemini",
      "config": {
        "profile": "custom",
        "custom": {
          "apikey": "${ROCKETRIDE_GEMINI_KEY}",
          "model": "models/gemini-3.6-flash",
          "modelTotalTokens": 4000,
          "outputTokens": 1200
        }
      },
      "input": [
        {
          "lane": "questions",
          "from": "prompt_1"
        }
      ]
    },
    {
      "id": "response_text_1",
      "provider": "response_text",
      "config": {
        "laneName": "analysis"
      },
      "input": [
        {
          "lane": "answers",
          "from": "llm_gemini_1"
        }
      ]
    }
  ],
  "project_id": "574d3846-d774-401e-b2a8-19fecb62736b",
  "viewport": {
